      "unicode_span_semantics"
    ]
  },
  "cutover": {
    "permitted": false,
    "required_entry_gates": ["compiler_scale_runtime_proof", "diagnostics_contract_qualification", "maintainer_cutover_approval", "parent_runtime_prerequisites"],
    "required_proofs": [
      "axiom_owned_syntax_package_qualified",
      "axiom_package_executes_same_binary_runtime_ab",
      "canonical_node_identity_collision_vectors_pass",
      "differential_corpus_matches",
      "doc_comment_trivia_parity_passes",
      "fuzz_corpus_qualification_passes",
      "line_comment_trivia_parity_passes",
      "macro_failure_codes_match",
      "macro_limit_ceiling_vectors_pass",
      "recovered_nodes_and_diagnostics_match",
      "rust_syntax_path_disabled",
      "unicode_span_vectors_match"
    ],
    "approval_binding": "maintainer_identity_plus_exact_artifact_sha256",
