{
  "schema_version": "axiom.runtime_http_server.v1",
  "contract": "runtime.http_server",
  "issue": 1449,
  "implementation": {
    "tier": "static_spike",
    "status": "partial",
    "runtime_backed_subset": true,
    "build_once_run_many": true,
    "loopback_only": true,
    "bounded_fixed_route": true,
    "dynamic_handler": false,
    "external_bind": false,
    "structured_concurrency": false,
    "http_1_1_proxy": false,
    "graceful_drain": false,
    "observability_flush": false
  },
  "authority": {
    "required_kind": "listen",
    "current_grant": "net",
    "separate_listen_grant_required": true,
    "default_deny": true,
    "endpoint_fields": ["host", "ip", "port", "transport"],
    "wildcard_policy": "explicit_exact_authority_only",
    "runtime_resolution": "required",
    "runtime_revalidation": true,
    "fallback": "deny_without_rebind",
    "proxy_authority": {
      "required_kind": "proxy",
      "selector_fields": ["peer_network", "peer_port", "prefix_length", "transport"],
      "match_rule": "transport peer must match an explicit network prefix port and transport before forwarded metadata is trusted",
      "forwarded_header": "Forwarded",
      "proxy_rewrite_rule": "matching proxy must remove every client-supplied Forwarded field and emit exactly one field with exactly one canonical for parameter",
      "duplicate_or_chain_policy": "reject duplicate Forwarded fields comma-separated chains unknown identifiers obfuscated identifiers and noncanonical for parameters",
      "effective_client_identity": "canonical for parameter from the single proxy-rewritten Forwarded field",
      "handler_peer": "transport_observed_proxy_peer_remains_request_peer",
      "missing_or_mismatch": "deny forwarded metadata and retain the transport-observed peer"
    }
  },
  "request": {
    "fields": ["body_bytes", "body_text", "headers", "method", "path", "peer", "query"],
    "body_representations": ["bytes", "text"],
    "header_policy": "ordered_case_insensitive_names_preserve_duplicates",
    "framing_policy": "validate_before_body_allocation",
    "peer_policy": "transport_observed_not_forwarded_header"
  },
  "response": {
    "fields": ["body", "headers", "status"],
    "status_minimum": 200,
    "status_maximum": 599,
    "body_representations": ["bytes", "text"],
    "header_policy": "transmit_non_framing_headers_in_declared_order_and_values",
    "framing_policy": "reject_handler_content_length_and_transfer_encoding_then_emit_exact_content_length",
    "bodyless_policy": {
      "head": "suppress_body_content_length_may_describe_selected_representation",
      "status_204": "reject_handler_body_and_omit_content_length",
      "status_205": "reject_handler_body_and_emit_zero_content_length",
      "status_304": "suppress_body_content_length_may_describe_selected_representation"
    },
    "terminal_rule": "exactly_one_response_or_explicit_abort",
    "injection_policy": "require_rfc9110_field_name_token_and_reject_control_characters_in_values"
  },
  "handler": {
    "semantic_node": "axiom://runtime/http-server/handler",
    "input": "request",
    "output": "response",
    "task_scope": "request_child_of_server",
    "resource_scope": "connection_child_of_server_requests_borrow_connection",
    "panic_policy": "bounded_500_then_close_when_uncommitted",
    "cancellation_policy": "cooperative_until_deadline_then_force_close",
    "fallback": "no_thread_per_connection"
  },
  "limits": {
    "max_connections": 1024,
    "max_in_flight": 128,
    "max_requests_per_connection": 100,
    "accept_queue": 256,
    "handler_queue": 256,
    "start_line_bytes": 8192,
    "header_count": 64,
    "header_bytes": 65536,
    "body_bytes": 1048576,
    "read_timeout_ms": 5000,
    "write_timeout_ms": 5000,
    "idle_timeout_ms": 5000,
    "handler_timeout_ms": 30000,
    "shutdown_timeout_ms": 30000,
    "backpressure": {
      "bounded_queues": true,
      "listener_capacity": {
        "action": "pause_accept_until_capacity",
        "connection_state": "not_accepted",
        "http_response_possible": false
      },
      "handler_queue_capacity": {
        "action": "reject_accepted_request",
        "connection_state": "accepted",
        "overload_status": 503,
        "preserve_in_flight": true
      },
      "partial_write_progress": true,
      "zero_progress_rule": "wait_for_writable_or_deadline"
    }
  },
  "protocol": {
    "versions": ["HTTP/1.1"],
    "reverse_proxy": "supported_with_explicit_proxy_authority",
    "keep_alive": "bounded_requests_and_idle_deadline",
    "malformed_client": "bounded_error_then_close",
    "content_length": "reject_conflicting_or_incomplete",
    "transfer_encoding": "reject_ambiguous_or_unsupported",
    "forwarded_headers": "single_proxy_rewritten_Forwarded_for_value_only_with_matching_proxy_authority",
    "later_work": ["http_2", "websocket"]
  },
  "shutdown": {
    "states": ["accepting", "draining", "starting", "stopped"],
    "triggers": ["controlled", "sigterm"],
    "transition_order": "starting_accepting_draining_stopped",
    "stop_accepts_first": true,
    "drain_to_deadline": true,
    "cancel_remaining": true,
    "flush_observability": true,
    "close_resources": true,
    "terminal_state": "stopped"
  },
  "inspection_fields": ["accept_queue_depth", "bind_authority", "handler_semantic_node", "in_flight", "limits", "listen_endpoint", "overload_count", "request_id", "response_evidence", "runtime_request_origin", "server_id", "shutdown_deadline", "shutdown_state"],
  "outcomes": ["accepted", "authority_denied", "cancelled", "deadline_exceeded", "io_error", "malformed_request", "overloaded", "response_sent", "server_stopped", "unsupported"],
