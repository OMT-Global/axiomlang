{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-lang.org/schemas/axiom.runtime_process.v1.schema.json",
  "title": "AxiOM Runtime Process v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "issue", "implementation", "command", "stdio", "lifecycle", "terminal", "authority", "audit", "resource_limits", "bounds", "inspection_fields", "fixtures", "migration"],
  "properties": {
    "schema_version": {"const": "axiom.runtime_process.v1"},
    "contract": {"const": "runtime.process"},
    "issue": {"const": 1444},
    "implementation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "structured_api", "legacy_entrypoint", "legacy_semantics", "evidence", "blockers"],
          "properties": {
            "tier": {"const": "static_spike"},
            "structured_api": {"const": "contract_only"},
            "legacy_entrypoint": {"const": "run_status(command: string): int"},
            "legacy_semantics": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "blockers": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "integer"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "structured_api", "legacy_entrypoint", "legacy_semantics", "evidence", "blockers"],
          "properties": {
            "tier": {"const": "runtime_complete"},
            "structured_api": {"const": "implemented"},
            "legacy_entrypoint": {"const": "run_status(command: string): int"},
            "legacy_semantics": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "blockers": {"type": "array", "maxItems": 0, "uniqueItems": true, "items": {"type": "integer"}}
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "implicit_shell", "executable", "argv", "cwd", "environment"],
      "properties": {
        "fields": {"const": ["argv", "cwd", "environment", "executable", "resource_limits", "stdio", "timeout_ms"]},
        "implicit_shell": {"const": false},
        "executable": {"const": "one exact executable identity"},
        "argv": {"const": "ordered UTF-8 arguments preserved as distinct values with argv[0] equal to executable identity"},
        "cwd": {"const": "optional authority-checked directory identity"},
        "environment": {"const": "inherit nothing by default; pass only policy-approved keys with explicit values"}
      }
    },
    "stdio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "independent_stdout_stderr", "stdin_close", "capture_overflow"],
      "properties": {
        "modes": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["capture", "inherit", "null", "stream"]}},
        "independent_stdout_stderr": {"const": true},
        "stdin_close": {"const": "close after input is written or immediately when no input is supplied"},
        "capture_overflow": {"const": "terminate child and report process.output_limit_exceeded with bounded retained bytes"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "transitions", "initiating_outcome_preservation", "timeout_clock", "cancellation", "signals", "terminal_outcomes"],
      "properties": {
        "states": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["cancelled", "exited", "running", "signaled", "spawn_failed", "spawning", "timed_out"]}},
        "transitions": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"enum": ["cancelled->exited", "cancelled->signaled", "running->cancelled", "running->exited", "running->signaled", "running->timed_out", "spawning->running", "spawning->spawn_failed", "timed_out->exited", "timed_out->signaled"]}},
        "initiating_outcome_preservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cancelled", "timed_out"],
          "properties": {
            "cancelled": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminal_states", "outcome"],
              "properties": {
                "terminal_states": {"const": ["exited", "signaled"]},
                "outcome": {"const": "cancelled"}
              }
            },
            "timed_out": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminal_states", "outcome"],
              "properties": {
                "terminal_states": {"const": ["exited", "signaled"]},
                "outcome": {"const": "timeout"}
              }
            }
          }
        },
        "timeout_clock": {"const": "monotonic"},
        "cancellation": {"const": "request graceful termination, wait bounded grace, then force termination"},
        "signals": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["interrupt", "kill", "terminate"]}},
        "terminal_outcomes": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["cancelled", "exit_code", "output_limit_exceeded", "resource_limit_exceeded", "signal", "spawn_error", "timeout"]}}
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection", "size", "color_policy", "non_terminal_size"],
      "properties": {
        "detection": {"const": "query each inherited or streamed endpoint independently"},
        "size": {"const": "optional positive columns and rows from the attached terminal endpoint"},
        "color_policy": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["always", "auto", "never"]}},
        "non_terminal_size": {"const": "unavailable"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deny_by_default", "dimensions", "executable_rule", "argv_rule", "cwd_rule", "environment_rule", "process_control_rule", "runtime_cleanup_rule", "runtime_cleanup", "signals_rule", "stdio_rule", "terminal_rule"],
      "properties": {
        "deny_by_default": {"const": true},
        "dimensions": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["argv", "cwd", "environment", "executable", "process_control", "signals", "stdio", "terminal"]}},
        "executable_rule": {"const": "exact executable identity must be allowed before spawn"},
        "argv_rule": {"const": "argument count, origins, and structural policy are checked separately from executable identity"},
        "cwd_rule": {"const": "resolved cwd must remain inside an allowed root"},
        "environment_rule": {"const": "inheritance and each key are independently authorized; values never grant authority"},
        "process_control_rule": {"const": "caller wait, graceful termination, force termination, timeout handling, cancellation, and resource-limit ceilings are independently authorized"},
        "runtime_cleanup_rule": {"const": "process-control denial blocks only the caller-requested operation; runtime supervision remains mandatory, closes pipes and reaps every child, and handle abandonment triggers bounded graceful-then-forced termination"},
        "runtime_cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ownership", "denial_scope", "supervision_after_denial", "abandonment"],
          "properties": {
            "ownership": {"const": "runtime_owned"},
            "denial_scope": {"const": "caller_requested_operation_only"},
            "supervision_after_denial": {"const": true},
            "abandonment": {
              "type": "object",
              "additionalProperties": false,
              "required": ["grace_ms", "graceful_termination_requested", "force_termination_if_running", "pipes_closed", "child_reaped"],
              "properties": {
                "grace_ms": {"const": 5000},
                "graceful_termination_requested": {"const": true},
                "force_termination_if_running": {"const": true},
                "pipes_closed": {"const": true},
                "child_reaped": {"const": true}
              }
            }
          }
        },
        "signals_rule": {"const": "signal subscription and each portable signal send are independently authorized"},
        "stdio_rule": {"const": "stdin, stdout, and stderr modes are authorized independently before spawn"},
        "terminal_rule": {"const": "terminal detection, size queries, and terminal inheritance or streaming are independently authorized"}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_before_spawn", "decision_before_operation", "fields", "redacted_fields", "denied_rule"],
      "properties": {
        "decision_before_spawn": {"const": true},
        "decision_before_operation": {"const": true},
        "fields": {"const": ["argv_count", "argv_origins", "authority_dimension", "cwd_identity", "decision", "denied_dimensions", "environment_keys", "executable_identity", "operation", "stdio_modes", "terminal_requested"]},
        "redacted_fields": {"const": ["argv_values", "environment_values", "stdin_bytes"]},
        "denied_rule": {"const": "record denied dimensions and stable identities without spawning or recording argument, environment, or stdin values"}
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "default_rule", "authority_rule", "failures"],
      "properties": {
        "supported": {
          "const": [
            {"name": "cpu_time_ms", "unit": "milliseconds", "minimum": 1, "default": 30000, "maximum": 300000},
            {"name": "memory_bytes", "unit": "bytes", "minimum": 1048576, "default": 268435456, "maximum": 1073741824},
            {"name": "open_files", "unit": "count", "minimum": 3, "default": 64, "maximum": 1024},
            {"name": "subprocesses", "unit": "count", "minimum": 0, "default": 1, "maximum": 64}
          ]
        },
        "default_rule": {"const": "omitted values use finite published defaults; process_control authority may lower defaults but never remove a bound"},
        "authority_rule": {"const": "process_control authority sets a finite ceiling per supported limit; a request above its ceiling is denied before spawn"},
        "failures": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invalid_request", "unauthorized", "unsupported_host", "exceeded"],
          "properties": {
            "invalid_request": {"const": "reject before spawn with process.resource_limit_invalid"},
            "unauthorized": {"const": "reject before spawn with process.capability_denied"},
            "unsupported_host": {"const": "reject before spawn with process.resource_limit_unsupported"},
            "exceeded": {"const": "terminate and clean up with process.resource_limit_exceeded and the exceeded limit name"}
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_argv_entries", "max_argument_bytes", "max_environment_entries", "max_capture_bytes_per_stream", "max_stdin_bytes", "max_grace_ms"],
      "properties": {
        "max_argv_entries": {"const": 256},
        "max_argument_bytes": {"const": 65536},
        "max_environment_entries": {"const": 128},
        "max_capture_bytes_per_stream": {"const": 1048576},
        "max_stdin_bytes": {"const": 1048576},
        "max_grace_ms": {"const": 5000}
      }
    },
    "inspection_fields": {"const": ["argv_count", "argv_origins", "authority_decision", "cancellation_state", "cwd_identity", "environment_keys", "executable_identity", "exit_reason", "resource_limits", "stdio_modes", "terminal_dependencies", "timeout_ms"]},
    "fixtures": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "asserts"],
        "properties": {
          "id": {"type": "string", "pattern": "^axiom://process/fixture/[a-z0-9-]+$"},
          "kind": {"enum": ["negative", "positive"]},
          "path": {"type": "string", "minLength": 1},
          "asserts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "dependencies", "out_of_scope", "forbidden_terms"],
      "properties": {
        "compatibility": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "integer"}},
        "out_of_scope": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_terms": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
