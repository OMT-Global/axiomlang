{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "issue",
    "status",
    "collections",
    "keys",
    "hashing",
    "iteration",
    "resources",
    "ownership",
    "errors",
    "fixtures",
    "migration"
  ],
  "properties": {
    "schema_version": {
      "const": "axiom.runtime-associative-collections.v1"
    },
    "contract": {
      "const": "runtime.associative_collections"
    },
    "issue": {
      "const": 1476
    },
    "collections": {
      "type": "object"
    },
    "keys": {
      "type": "object"
    },
    "hashing": {
      "type": "object"
    },
    "iteration": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "ownership": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "minItems": 7,
      "items": {
        "enum": [
          "invalid_key_type",
          "allocation_failed",
          "collection_limit",
          "collision_limit",
          "concurrent_collection_mutation",
          "use_after_move",
          "borrow_violation"
        ]
      }
    },
    "fixtures": {
      "type": "array"
    },
    "status": {
      "const": "contract_only"
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_input",
        "dependencies",
        "out_of_scope",
        "forbidden_terms"
      ],
      "properties": {
        "semantic_input": {
          "const": "Axiom semantic collection operations and lifecycle provenance"
        },
        "dependencies": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "integer"
          }
        },
        "out_of_scope": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_terms": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$id": "https://omt-global.github.io/axiom/schemas/axiom.runtime_associative_collections.v1.schema.json"
}
