{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-lang.org/schemas/axiom.runtime_network_authority.v2.schema.json",
  "title": "AxiOM runtime network authority v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "issue", "directions", "rules", "audit", "fixtures"],
  "properties": {
    "schema_version": {"const": "axiom.runtime_network_authority.v2"},
    "contract": {"const": "runtime.network_authority"},
    "issue": {"const": 1447},
    "directions": {
      "type": "array", "minItems": 4,
      "items": {"enum": ["dns", "outbound_connect", "inbound_listen", "accepted_peer"]}
    },
    "rules": {"$ref": "#/$defs/rules"},
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["fields", "redaction"],
      "properties": {
        "fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "redaction": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "fixtures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "path", "asserts"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "asserts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$defs": {
    "rules": {
      "type": "object", "additionalProperties": false,
      "required": ["dns", "outbound_connect", "inbound_listen", "accepted_peer"],
      "properties": {
        "dns": {"$ref": "#/$defs/rule"},
        "outbound_connect": {"$ref": "#/$defs/rule"},
        "inbound_listen": {"$ref": "#/$defs/rule"},
        "accepted_peer": {"$ref": "#/$defs/rule"}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "host_patterns", "ip_cidrs", "ports", "interfaces", "unix_sockets", "dynamic_endpoints", "rebinding"],
      "properties": {
        "decision": {"enum": ["allow", "deny"]},
        "host_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ip_cidrs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ports": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]+(-[0-9]+)?$"}},
        "interfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unix_sockets": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "dynamic_endpoints": {"enum": ["deny", "validate_each_resolution"]},
        "rebinding": {"enum": ["deny", "revalidate_before_use"]}
      }
    }
  }
}
