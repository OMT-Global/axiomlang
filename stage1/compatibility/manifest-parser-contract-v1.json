{
  "schema_version": "axiom.compatibility_manifest_parser.v1",
  "dependency_version_pattern": "^(\\*|\\^?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))$",
  "test_kinds": [
    "unit",
    "table",
    "property",
    "snapshot",
    "benchmark"
  ],
  "test_capabilities": {
    "mode": "unsupported_empty_only",
    "names": [
      "fs",
      "fs:write",
      "net",
      "process",
      "env",
      "clock",
      "crypto",
      "ffi",
      "async"
    ]
  }
}
