{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.omt.global/schemas/axiom-selfhost-snapshot-manifest-v0.schema.json",
  "title": "Axiom Self-Hosting Snapshot Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshots"],
  "properties": {
    "schema_version": { "const": "axiom.selfhost.snapshot_manifest.v0" },
    "snapshots": { "type": "array", "items": { "$ref": "#/$defs/snapshot" } }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "chain_id",
        "sequence",
        "version",
        "target",
        "sha256",
        "artifact_path",
        "source",
        "source_head_sha",
        "built_by",
        "predecessor",
        "provenance",
        "provenance_sha256"
      ],
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1 },
        "chain_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "version": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "built_by": { "enum": ["cargo", "axiomc-snapshot"] },
        "predecessor": { "type": ["string", "null"] },
        "provenance": { "type": "string", "minLength": 1 },
        "provenance_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
