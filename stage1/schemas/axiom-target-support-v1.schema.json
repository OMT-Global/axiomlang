{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.omt.global/schemas/axiom-target-support-v1.schema.json",
  "title": "Axiom Native Target Support v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend",
    "host_target",
    "host_supported",
    "target_selection",
    "supported_targets"
  ],
  "properties": {
    "schema_version": { "const": "axiom.target_support.v1" },
    "backend": { "const": "cranelift" },
    "host_target": { "type": ["string", "null"] },
    "host_supported": { "type": "boolean" },
    "target_selection": { "const": "exact-host-only" },
    "supported_targets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "platform",
          "object_format",
          "abi",
          "linker",
          "runtime",
          "status"
        ],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "object_format": { "type": "string", "minLength": 1 },
          "abi": { "type": "string", "minLength": 1 },
          "linker": { "type": "string", "minLength": 1 },
          "libc": {
            "description": "Additive v1 qualification metadata. Optional for compatibility with earlier v1 producers; current axiomc reports always emit it.",
            "enum": ["darwin-libsystem", "glibc-compatible"]
          },
          "runtime": { "type": "string", "minLength": 1 },
          "provider_policy": {
            "description": "Additive v1 qualification metadata. Optional for compatibility with earlier v1 producers; current axiomc reports always emit it.",
            "const": "capability-providers-qualified-separately"
          },
          "profiles": {
            "description": "Additive v1 qualification metadata. Optional for compatibility with earlier v1 producers; current axiomc reports always emit it.",
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "prefixItems": [
              { "const": "debug" },
              { "const": "release" }
            ],
            "items": false
          },
          "unsupported_features": {
            "description": "Additive v1 qualification metadata. Optional for compatibility with earlier v1 producers; current axiomc reports always emit it.",
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "prefixItems": [
              { "const": "cross-compilation" },
              { "const": "direct-native-wasm" },
              { "const": "windows-native" }
            ],
            "items": false
          },
          "status": { "const": "supported-host-only" }
        }
      }
    }
  }
}
