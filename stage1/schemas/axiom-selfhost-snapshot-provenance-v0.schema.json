{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.omt.global/schemas/axiom-selfhost-snapshot-provenance-v0.schema.json",
  "title": "Axiom Self-Hosting Snapshot Provenance v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "chain_id",
    "sequence",
    "version",
    "target",
    "source",
    "source_head_sha",
    "built_by",
    "predecessor",
    "predecessor_artifact_sha256",
    "artifact_sha256",
    "execution"
  ],
  "properties": {
    "schema_version": { "const": "axiom.selfhost.snapshot_provenance.v0" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "chain_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "version": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "source_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "built_by": { "enum": ["cargo", "axiomc-snapshot"] },
    "predecessor": { "type": ["string", "null"] },
    "predecessor_artifact_sha256": { "type": ["string", "null"] },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "execution": { "$ref": "#/$defs/execution" }
  },
  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "target",
        "source",
        "source_head_sha",
        "predecessor",
        "predecessor_artifact_sha256",
        "version",
        "command",
        "processes",
        "offline",
        "network_access",
        "generated_rust",
        "output",
        "fixpoint"
      ],
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "predecessor": { "type": ["string", "null"] },
        "predecessor_artifact_sha256": { "type": ["string", "null"] },
        "version": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "processes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "offline": { "type": "boolean" },
        "network_access": { "type": "boolean" },
        "generated_rust": { "type": "null" },
        "output": { "$ref": "#/$defs/output" },
        "fixpoint": { "$ref": "#/$defs/fixpoint" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifact_sha256", "divergent"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "divergent": { "type": "boolean" }
      }
    },
    "fixpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "normalized_equal", "first_sha256", "second_sha256"],
      "properties": {
        "status": { "enum": ["not_applicable", "pass", "fail"] },
        "normalized_equal": { "type": ["boolean", "null"] },
        "first_sha256": { "type": ["string", "null"] },
        "second_sha256": { "type": ["string", "null"] }
      }
    }
  }
}
